# Copy to .env and fill in values. Never commit .env.

# Postgres (local docker-compose default). Railway sets DATABASE_URL automatically.
DATABASE_URL=postgresql://trippy:trippy@localhost:5433/trippy

# OpenAI — required for the AI chat agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend (local Vite only; leave empty in production so API is same-origin)
VITE_API_BASE_URL=http://localhost:8000

# CORS for local Vite (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
